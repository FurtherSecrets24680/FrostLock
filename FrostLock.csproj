<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FrostLock</AssemblyName>
    <RootNamespace>FrostLock</RootNamespace>
    <Product>FrostLock</Product>
    <AssemblyTitle>FrostLock</AssemblyTitle>
    <Company>FurtherSecrets</Company>
    <Copyright>Copyright (C) 2026 FurtherSecrets</Copyright>
    <Version>1.4.0</Version>
    <RepositoryUrl>https://github.com/FurtherSecrets24680/FrostLock</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/FurtherSecrets24680/FrostLock</PackageProjectUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\frostlock.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\frostlock.ico" />
  </ItemGroup>

  <!-- WPF and WinForms are both enabled (WinForms only for the tray icon). Drop the
       WinForms implicit usings so type names like Application/Timer/CheckBox stay unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Page Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrostLock.Tests" />
  </ItemGroup>

</Project>
