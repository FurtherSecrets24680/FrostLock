<ui:FluentWindow x:Class="FrostLock.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="About FrostLock"
                 Width="520"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 FontSize="14"
                 TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AboutTitleBar" Grid.Row="0" Title="About"
                     ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,24">

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="58" Height="58" CornerRadius="14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Image x:Name="AppIcon" Width="42" Height="42"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,8,0">
                    <TextBlock Text="FrostLock" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Input control, on your terms" Style="{StaticResource RowDescription}" Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Center" Padding="10,5"
                        CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <TextBlock x:Name="TxtVersion" Text="Version 1.0.0"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>

            <TextBlock Text="A Windows utility for temporarily freezing keyboard and mouse input, with a lock screen and safety controls."
                       Style="{StaticResource RowDescription}" Margin="0,14,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,22,0,9">
                <ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="System details" Style="{StaticResource SectionHeader}" Margin="0" />
            </StackPanel>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,8">
            <StackPanel>
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Publisher" Style="{StaticResource RowDescription}" />
                    <TextBlock x:Name="TxtPublisher" Grid.Column="1" Text="FurtherSecrets"
                               Style="{StaticResource RowValue}" />
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Application" Style="{StaticResource RowDescription}" />
                    <TextBlock x:Name="TxtApp" Grid.Column="1" Text="FrostLock" Style="{StaticResource RowValue}" />
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text=".NET runtime" Style="{StaticResource RowDescription}" />
                    <TextBlock x:Name="TxtDotNet" Grid.Column="1" Text=".NET 10" Style="{StaticResource RowValue}" />
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="WPF-UI" Style="{StaticResource RowDescription}" />
                    <TextBlock x:Name="TxtWpfUi" Grid.Column="1" Text="4.3.0" Style="{StaticResource RowValue}" />
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Windows" Style="{StaticResource RowDescription}" />
                    <TextBlock x:Name="TxtWindows" Grid.Column="1" Text="Windows" Style="{StaticResource RowValue}" />
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Architecture" Style="{StaticResource RowDescription}" />
                    <TextBlock x:Name="TxtArch" Grid.Column="1" Text="X64" Style="{StaticResource RowValue}" />
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Running as" Style="{StaticResource RowDescription}" />
                    <TextBlock x:Name="TxtRole" Grid.Column="1" Text="Standard user" Style="{StaticResource RowValue}" />
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Settings file" Style="{StaticResource RowDescription}" />
                    <TextBlock x:Name="TxtSettings" Grid.Column="1" Text="%AppData%\FrostLock\settings.json"
                               Style="{StaticResource RowValue}" TextWrapping="Wrap" ToolTip="Full path to settings.json" />
                </Grid>
            </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Path Fill="{DynamicResource TextFillColorSecondaryBrush}"
                          Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                </Viewbox>
                <TextBlock VerticalAlignment="Center">
                    <Hyperlink x:Name="LinkSource"
                               NavigateUri="https://github.com/FurtherSecrets24680/FrostLock"
                               RequestNavigate="Source_RequestNavigate"
                               Style="{StaticResource AppHyperlink}"
                               ToolTip="https://github.com/FurtherSecrets24680/FrostLock"
                               TextDecorations="None">View source code on GitHub</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Hidden rather than Collapsed: the space is reserved up front, so showing
                 the status line never changes the window's height. -->
            <TextBlock x:Name="TxtCopyStatus" Text="Details copied to the clipboard."
                       Style="{StaticResource RowDescription}"
                       Visibility="Hidden"
                       Margin="0,12,0,0" />

            <TextBlock x:Name="TxtUpdateStatus" Text="Checking for updates…"
                       Style="{StaticResource RowDescription}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Hidden"
                       Margin="0,12,0,0" />

            <!-- Reserved height: showing progress never resizes the window. -->
            <ProgressBar x:Name="UpdateProgress"
                         Height="6"
                         Minimum="0" Maximum="1"
                         Value="0"
                         Visibility="Hidden"
                         Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button x:Name="BtnCheckUpdates" Content="Check for updates" Click="CheckUpdates_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="BtnCopy" Content="Copy details" Click="Copy_Click" Margin="8,0,0,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="BtnClose" Content="Close"
                           Appearance="Primary" MinWidth="110"
                           Margin="8,0,0,0"
                           Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
