<ui:FluentWindow x:Class="FrostLock.Views.SettingsFileWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="FrostLock settings file"
                 Width="820"
                 Height="660"
                 MinWidth="640"
                 MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 FontSize="14"
                 TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings file" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,12">
            <TextBlock Text="settings.json" FontSize="20" FontWeight="SemiBold" />

            <TextBlock Style="{StaticResource RowDescription}" Margin="0,4,0,0">
                <Run x:Name="RunPath" />
            </TextBlock>

            <TextBlock Text="Changes are validated before they are applied. The file contains your PIN hash and lifetime statistics, so treat a copy like a password."
                       Style="{StaticResource RowDescription}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Margin="24,0,24,0"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <ui:TextBox x:Name="JsonBox"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalContentAlignment="Top"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12.5"
                        Padding="10"
                        BorderThickness="0"
                        SpellCheck.IsEnabled="False" />
        </Border>

        <ui:InfoBar x:Name="StatusBar"
                    Grid.Row="3"
                    Severity="Error"
                    IsClosable="True"
                    IsOpen="False"
                    Margin="24,10,24,0" />

        <Grid Grid.Row="4" Margin="24,10,24,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button x:Name="BtnReload" Content="Reload from disk" Click="Reload_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="16" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="BtnOpenFolder" Content="Open folder" Click="OpenFolder_Click" Margin="8,0,0,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BtnClose" Content="Close" MinWidth="96" Click="Close_Click" />
                <ui:Button x:Name="BtnSave" Content="Save &amp; apply"
                           Appearance="Primary" MinWidth="128" Margin="8,0,0,0"
                           Click="Save_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Save24" FontSize="16" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
