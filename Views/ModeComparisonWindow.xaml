<ui:FluentWindow x:Class="FrostLock.Views.ModeComparisonWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="FrostLock locking modes"
                 Width="1100"
                 SizeToContent="Height"
                 MaxHeight="800"
                 MinWidth="850"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="CanResize"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 FontSize="14"
                 TextOptions.TextFormattingMode="Ideal">

    <ui:FluentWindow.Resources>
        <Style x:Key="TableHeaderCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="10,11" />
        </Style>
        <Style x:Key="TableCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,12" />
        </Style>
        <Style x:Key="TableText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" Title="Compare locking modes"
                     ShowMinimize="False" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Padding="24,12,24,8">
            <StackPanel>
                <TextBlock Text="Compare how each mode blocks input, what it’s suited for, and how to release it."
                           Style="{StaticResource RowDescription}"
                           FontSize="13"
                           Margin="0,0,0,12" />

                <Grid MinWidth="1000">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135" />
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TableHeaderCell}"><TextBlock Text="MODE" FontWeight="SemiBold" /></Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TableHeaderCell}"><TextBlock Text="INPUT BLOCKING" FontWeight="SemiBold" /></Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TableHeaderCell}"><TextBlock Text="ADMIN?" FontWeight="SemiBold" /></Border>
                    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource TableHeaderCell}"><TextBlock Text="BEST FOR" FontWeight="SemiBold" /></Border>
                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource TableHeaderCell}"><TextBlock Text="HOW TO RELEASE" FontWeight="SemiBold" /></Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TableCell}"><TextBlock Text="Gentle" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="Suppresses common system shortcuts; mouse stays live." /></Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="No" /></Border>
                    <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="An easy-to-release pause." /></Border>
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="On-screen Unlock button, unlock shortcut, or timer." /></Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource TableCell}"><TextBlock Text="Strict" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="Low-level keyboard and mouse hooks; blocking can be configured." /></Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="No" /></Border>
                    <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="Strong app-level input blocking without elevation." /></Border>
                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="Unlock shortcut, clickable Unlock if the mouse is live, or timer." /></Border>

                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource TableCell}"><TextBlock Text="Hard" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></Border>
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="Windows BlockInput blocks keyboard and mouse at the OS level." /></Border>
                    <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="Yes" /></Border>
                    <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="A more forceful, OS-level block." /></Border>
                    <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="Ctrl+Alt+Del, return to FrostLock and click Unlock; timer, safety cap, or watchdog." /></Border>

                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource TableCell}"><TextBlock Text="PIN" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></Border>
                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="Keyboard and mouse stay usable; system shortcuts are suppressed." /></Border>
                    <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="No" /></Border>
                    <Border Grid.Row="4" Grid.Column="3" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="Secret-controlled release while input remains available." /></Border>
                    <Border Grid.Row="4" Grid.Column="4" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="PIN, configured emergency phrase, or timer." /></Border>

                    <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource TableCell}"><TextBlock Text="USB key" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></Border>
                    <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="Watches a selected removable drive; triggers a Strict freeze on the configured plug/unplug action." /></Border>
                    <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="No" /></Border>
                    <Border Grid.Row="5" Grid.Column="3" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="A physical convenience trigger; volume serial is not secure authentication." /></Border>
                    <Border Grid.Row="5" Grid.Column="4" Style="{StaticResource TableCell}"><TextBlock Style="{StaticResource TableText}" Text="Configured opposite drive action, unlock shortcut, timer, or Stop watching. Cannot release PIN mode." /></Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,20">
            <ui:Button Content="Close"
                       Appearance="Primary"
                       MinWidth="104"
                       IsDefault="True"
                       IsCancel="True"
                       Click="Close_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
