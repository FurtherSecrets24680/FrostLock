<Window x:Class="FrostLock.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="FrostLock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Background="#FF1C1C1C"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="48,40,48,0">
            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                       Foreground="#FF9C9C9C" VerticalAlignment="Center" />
            <TextBlock Text="FrostLock" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="ModeText" Text="Gentle lock" Foreground="#FF9C9C9C"
                       Margin="14,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Center -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
            <TextBlock x:Name="PhaseText"
                       Text="Input is frozen"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="52" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                       TextAlignment="Center" HorizontalAlignment="Center" />

            <TextBlock x:Name="TimerText"
                       Text="--:--"
                       FontSize="24" Foreground="#FFC9C9C9"
                       Margin="0,10,0,0"
                       TextAlignment="Center" HorizontalAlignment="Center" />

            <ProgressBar x:Name="RemainingBar"
                         Width="420" Height="4"
                         Minimum="0" Maximum="1" Value="1"
                         Margin="0,26,0,0"
                         Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                         Background="#26FFFFFF" />

            <TextBlock x:Name="HintText"
                       Foreground="#FFB4B4B4"
                       Margin="0,30,0,0"
                       MaxWidth="660"
                       TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" />

            <!-- PIN mode: the only way out, so it replaces the plain Unlock button. -->
            <StackPanel x:Name="PinPanel"
                        Width="260"
                        Margin="0,26,0,0"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <PasswordBox x:Name="PinBox"
                             Height="36"
                             Padding="10,0"
                             FontSize="15"
                             VerticalContentAlignment="Center" />

                <TextBlock x:Name="PinError"
                           Text="Incorrect PIN."
                           Foreground="#FFFF9A9A"
                           FontSize="12"
                           Margin="2,8,0,0"
                           Visibility="Collapsed" />

                <ui:Button x:Name="PinSubmitButton"
                           Content="Unlock"
                           Appearance="Primary"
                           Height="40"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           Click="PinSubmit_Click" />
            </StackPanel>

            <ui:Button x:Name="UnlockButton"
                       Content="Unlock now"
                       Appearance="Primary"
                       Height="40" MinWidth="200"
                       Margin="0,28,0,0"
                       HorizontalAlignment="Center"
                       Click="UnlockButton_Click" />

            <TextBlock x:Name="SafetyText"
                       Text="Ctrl+Alt+Del always reaches the Windows security screen."
                       FontSize="12" Foreground="#FF8C8C8C"
                       Margin="0,18,0,0"
                       TextAlignment="Center" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
