<ui:FluentWindow x:Class="FrostLock.Views.MobilePairingQrWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="LAN phone pairing"
                 Width="580" Height="695" MinWidth="520" MinHeight="660"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 WindowBackdropType="Mica" WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True" ResizeMode="CanResize"
                 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="LAN phone pairing" ShowMaximize="False" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="520" Margin="34,18,34,30">
                <TextBlock Text="Pair FrostLock Remote" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Scan this temporary QR code with FrostLock Remote. Approve the phone on this PC to complete pairing."
                           TextWrapping="Wrap" TextAlignment="Center" Margin="8,7,8,20"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Border Width="320" Height="320" Padding="12" Background="White"
                        BorderBrush="#D8E1E8" BorderThickness="1" CornerRadius="14"
                        HorizontalAlignment="Center">
                    <Image x:Name="QrImage" Stretch="Uniform"
                           AutomationProperties.Name="Temporary FrostLock phone pairing QR code" />
                </Border>
                <ui:Button x:Name="RefreshButton" Appearance="Primary" MinWidth="190"
                           HorizontalAlignment="Center" Margin="0,12,0,0"
                           Click="RefreshCode_Click" AutomationProperties.Name="Refresh QR code">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh QR code" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="LAN endpoint" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="InviteEndpoint" Margin="0,3,12,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="10,6" CornerRadius="8"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ExpiryLabel" Text="Expires in 3:00" FontSize="12" />
                    </Border>
                </Grid>

                <Button x:Name="ToggleEncryptedTextButton" Content="Show encrypted text  ▾"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Margin="0,16,0,0" Padding="10,8"
                        Click="ToggleEncryptedText_Click"
                        AutomationProperties.Name="Show encrypted pairing text" />
                <StackPanel x:Name="EncryptedTextPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBox x:Name="InviteCode" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="76" MaxHeight="104" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Encrypted LAN pairing text" />
                    <Button Content="Copy text" MinWidth="96" HorizontalAlignment="Right"
                            Margin="0,6,0,0" Click="CopyCode_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="This code works once and expires automatically. Refresh it if you need a new code."
                           TextWrapping="Wrap" Margin="0,7,0,0" MinHeight="36"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
